{
  "name": "@scouterna/ui-webc",
  "version": "4.5.3",
  "description": "Scouterna Design System Web Components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scouterna/ui.git",
    "directory": "packages/ui-webc"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/ui-webc/ui-webc.esm.js",
  "exports": {
    ".": {
      "import": "./dist/ui-webc/ui-webc.esm.js",
      "require": "./dist/ui-webc/ui-webc.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": {
      "import": "./dist/ui-webc/ui-webc.css",
      "require": "./dist/ui-webc/ui-webc.css"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "scripts": {
    "build": "stencil build",
    "dev": "STENCIL_SKIP_MINIFY=true stencil build --watch",
    "serve": "stencil build --watch --serve",
    "test": "stencil test --spec --e2e",
    "test:watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@scouterna/design-tokens": "workspace:^",
    "@stencil/react-output-target": "^1.8.1",
    "@tabler/icons": "^3.52.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-focus-lock": "^1.1.0",
    "iconoir": "^7.12.2"
  },
  "devDependencies": {
    "@stencil-community/postcss": "^2.2.0",
    "@stencil/core": "^4.45.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.3",
    "puppeteer": "^25.18.1"
  },
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js"
}
